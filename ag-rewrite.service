[Unit]
Description=ag-rewrite (system prompt rewriter between gateway and upstream proxy)
After=network.target docker.service

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/ag-rewrite
ExecStart=/usr/bin/python3 /opt/ag-rewrite/proxy.py
Environment=AG_UPSTREAM=http://127.0.0.1:8045
Environment=AG_LISTEN_HOST=127.0.0.1
Environment=AG_LISTEN_PORT=8046
Environment=AG_LOG=/var/log/ag-rewrite.log
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
